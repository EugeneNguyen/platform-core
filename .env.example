# Copy to `.env` at the repo root and adjust as needed.
# docker compose automatically loads `.env` from the project root.

# ---------------------------------------------------------------------------
# Compose profile selection: one docker-compose.yml, two profiles.
#   dev  -> Vite dev server + hot reload, single external port
#   prod -> static frontend build served by nginx, single external port
# ---------------------------------------------------------------------------
COMPOSE_PROFILES=dev

# ---------------------------------------------------------------------------
# Postgres credentials.
# ---------------------------------------------------------------------------
POSTGRES_PASSWORD=platform_core_dev_password

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------
ENV=dev
# JWT signing secret. Placeholder only — generate and set a real secret
# before any production deployment.
JWT_SECRET=change-me-in-production
